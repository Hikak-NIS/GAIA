# PostgreSQL is the primary runtime database. This password is a local example only.
POSTGRES_DB=gaia
POSTGRES_USER=gaia
POSTGRES_PASSWORD=gaia_dev_change_me
DATABASE_URL=postgresql+psycopg://gaia:gaia_dev_change_me@localhost:5432/gaia

ENVIRONMENT=development
WEB_ORIGIN=http://localhost:5173
BACKGROUND_ENABLED=true
SESSION_DAYS=7
VITE_API_TARGET=http://127.0.0.1:8000

# Email verification is required for registration and each password login.
# Gmail: use an App Password, never your ordinary account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# OpenAI: server-only key. Text, microphone transcription and AI-generated speech.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral

# Copernicus Data Space dashboard > User settings > OAuth clients
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# NASA Earthdata profile token; public CMR, GIBS, EONET do not require it.
EARTHDATA_TOKEN=
# https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=
# Registered Google Cloud Earth Engine project and server service-account JSON.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
# Optional commercial Open-Meteo subscription. Empty: free non-commercial endpoint.
OPENMETEO_API_KEY=
# Historical simulation code is retained for regression tests, disabled in the product.
LEGACY_SIMULATION_ENABLED=false
